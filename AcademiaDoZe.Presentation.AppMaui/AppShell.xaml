<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AcademiaDoZe.Presentation.AppMaui.AppShell"
    x:Name="AppShellRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Views"
    Title="Academia do Zé"
    FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource WarmWhite}, Dark={StaticResource OffBlack}}">

    <Shell.FlyoutHeader>
        <Border BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                Stroke="{AppThemeBinding Light=#D8D4CC, Dark={StaticResource Gray600}}"
                StrokeThickness="0"
                Padding="16,20">
            <VerticalStackLayout Spacing="8">
                <Border BackgroundColor="White"
                        Stroke="#D8D4CC"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="4">
                    <Image Source="{Binding Source={x:Reference AppShellRoot}, Path=MenuLogoImage}"
                           HeightRequest="92"
                           Aspect="AspectFit"/>
                </Border>
                <Label Text="Academia do Zé"
                       TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource White}}"
                       FontFamily="OpenSansSemibold"
                       FontAttributes="Bold"
                       FontSize="16"/>
            </VerticalStackLayout>
        </Border>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Dashboard">
        <ShellContent ContentTemplate="{DataTemplate views:DashboardListPage}" Route="dashboard" />
    </FlyoutItem>

    <FlyoutItem Title="Logradouros">
        <ShellContent ContentTemplate="{DataTemplate views:LogradouroListPage}" Route="logradouros" />
    </FlyoutItem>

    <Shell.FlyoutFooter>
        <Label Text="Vitor Hugo Ribeiro Sá"
               Style="{StaticResource MutedText}"
               FontSize="12"
               Margin="18,10,18,18"/>
    </Shell.FlyoutFooter>

</Shell>
