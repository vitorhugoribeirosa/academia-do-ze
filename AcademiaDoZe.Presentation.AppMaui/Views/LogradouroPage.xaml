<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.LogradouroPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             x:DataType="vm:LogradouroViewModel"
             Title="{Binding Title}">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="32,26,32,40"
                                 Spacing="24"
                                 MaximumWidthRequest="900"
                                 HorizontalOptions="Fill">

                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding Title}" Style="{StaticResource HeaderTitle}"/>
                    <Label Text="Informe os dados do endereço. A busca por CEP pode preencher parte do formulário."
                           Style="{StaticResource HeaderSubtitle}"/>
                    <BoxView Style="{StaticResource SectionRule}" Margin="0,10,0,0"/>
                </VerticalStackLayout>

                <Border Style="{StaticResource FlatSection}">
                    <Grid ColumnDefinitions="180,*,130" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                            <Label Text="Consulta por CEP" Style="{StaticResource CardTitle}" FontSize="16"/>
                            <Label Text="Preenchimento automático" Style="{StaticResource MutedText}" FontSize="11"/>
                        </VerticalStackLayout>
                        <Entry Grid.Column="1"
                               Text="{Binding Logradouro.Cep}"
                               Placeholder="00000-000"
                               Keyboard="Numeric"/>
                        <Button Grid.Column="2"
                                Text="Buscar CEP"
                                Command="{Binding SearchByCepCommand}"
                                Style="{StaticResource ButtonPrimary}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource FlatSection}">
                    <VerticalStackLayout Spacing="18">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Dados do endereço" Style="{StaticResource CardTitle}"/>
                            <Label Grid.Column="1"
                                   Text="{Binding Logradouro.Id, StringFormat='ID {0}'}"
                                   Style="{StaticResource MutedText}"
                                   VerticalTextAlignment="Center"/>
                        </Grid>
                        <BoxView Style="{StaticResource SectionRule}"/>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Nome / Rua" Style="{StaticResource FieldLabel}"/>
                            <Entry Text="{Binding Logradouro.Nome}" Placeholder="Nome da rua"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Bairro" Style="{StaticResource FieldLabel}"/>
                            <Entry Text="{Binding Logradouro.Bairro}" Placeholder="Bairro"/>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,140" ColumnSpacing="14">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Cidade" Style="{StaticResource FieldLabel}"/>
                                <Entry Text="{Binding Logradouro.Cidade}" Placeholder="Cidade"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Estado" Style="{StaticResource FieldLabel}"/>
                                <Entry Text="{Binding Logradouro.Estado}" Placeholder="UF"/>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="País" Style="{StaticResource FieldLabel}"/>
                            <Entry Text="{Binding Logradouro.Pais}" Placeholder="País"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout HorizontalOptions="End" Spacing="10">
                    <Button Text="Cancelar"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource ButtonSecondary}"
                            WidthRequest="118"/>
                    <Button Text="Salvar logradouro"
                            Command="{Binding SaveLogradouroCommand}"
                            Style="{StaticResource ButtonPrimary}"
                            WidthRequest="174"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsVisible="{Binding IsBusy}"
                           IsRunning="{Binding IsBusy}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>
    </Grid>
</ContentPage>
