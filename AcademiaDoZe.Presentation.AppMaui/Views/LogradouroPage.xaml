<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.LogradouroPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             x:DataType="vm:LogradouroViewModel"
             Title="{Binding Title}">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,20,24,34"
                                 Spacing="18"
                                 MaximumWidthRequest="900"
                                 HorizontalOptions="Fill">
                <Grid ColumnDefinitions="8,*" ColumnSpacing="14">
                    <BoxView Grid.Column="0" Color="{StaticResource Primary}" CornerRadius="4"/>
                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                        <Label Text="Cadastro de logradouro" Style="{StaticResource SectionTitle}"/>
                        <Label Text="Preencha os dados abaixo para salvar o endereço."
                               Style="{StaticResource MutedText}"/>
                    </VerticalStackLayout>
                </Grid>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="LOCALIZAÇÃO RÁPIDA" Style="{StaticResource FieldLabel}"/>
                                <Label Text="Informe o CEP e faça a busca automática."
                                       Style="{StaticResource MutedText}"
                                       FontSize="12"/>
                            </VerticalStackLayout>
                            <Border Grid.Column="1"
                                    BackgroundColor="{StaticResource Secondary}"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="12,6"
                                    VerticalOptions="Center">
                                <Label Text="CEP"
                                       TextColor="{StaticResource Primary}"
                                       FontFamily="OpenSansSemibold"
                                       FontAttributes="Bold"
                                       FontSize="12"/>
                            </Border>
                        </Grid>
                        <Grid ColumnDefinitions="*,130" ColumnSpacing="10">
                            <Entry Grid.Column="0"
                                   Text="{Binding Logradouro.Cep}"
                                   Placeholder="00000-000"
                                   Keyboard="Numeric"/>
                            <Button Grid.Column="1"
                                    Text="Buscar CEP"
                                    Command="{Binding SearchByCepCommand}"
                                    Style="{StaticResource ButtonPrimary}"
                                    HeightRequest="48"
                                    FontSize="14"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Dados do endereço" Style="{StaticResource SectionTitle}" FontSize="20"/>
                            <Border Grid.Column="1"
                                    BackgroundColor="{AppThemeBinding Light=#F1ECE3, Dark=#2A2A2A}"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="12,6"
                                    VerticalOptions="Center">
                                <Label Text="{Binding Logradouro.Id, StringFormat='ID {0}'}"
                                       Style="{StaticResource MutedText}"
                                       FontFamily="OpenSansSemibold"
                                       FontAttributes="Bold"
                                       FontSize="12"/>
                            </Border>
                        </Grid>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="NOME / RUA" Style="{StaticResource FieldLabel}"/>
                            <Entry Text="{Binding Logradouro.Nome}" Placeholder="Digite o nome da rua..."/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="BAIRRO" Style="{StaticResource FieldLabel}"/>
                            <Entry Text="{Binding Logradouro.Bairro}" Placeholder="Digite o bairro..."/>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,150" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="CIDADE" Style="{StaticResource FieldLabel}"/>
                                <Entry Text="{Binding Logradouro.Cidade}" Placeholder="Digite a cidade..."/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="ESTADO" Style="{StaticResource FieldLabel}"/>
                                <Entry Text="{Binding Logradouro.Estado}" Placeholder="UF"/>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="PAÍS" Style="{StaticResource FieldLabel}"/>
                            <Entry Text="{Binding Logradouro.Pais}" Placeholder="Digite o país..."/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Grid.Column="0"
                            Text="Cancelar"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource ButtonSecondary}"/>
                    <Button Grid.Column="1"
                            Text="Salvar logradouro"
                            Command="{Binding SaveLogradouroCommand}"
                            Style="{StaticResource ButtonPrimary}"/>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsVisible="{Binding IsBusy}"
                           IsRunning="{Binding IsBusy}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>
    </Grid>
</ContentPage>
