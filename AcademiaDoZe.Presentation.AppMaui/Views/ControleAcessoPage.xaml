<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             xmlns:helpers="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Helpers"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.ControleAcessoPage"
             x:DataType="vm:ControleAcessoViewModel"
             Title="{Binding Title}">
    <Grid>
        <ScrollView>
            <VerticalStackLayout x:Name="AnimatedContent" Padding="{StaticResource PageContentPadding}"
                                 Spacing="20" MaximumWidthRequest="1100" HorizontalOptions="Fill">
                <Grid RowDefinitions="Auto,Auto">
                    <Label Text="{helpers:Translate AccessControl}" Style="{StaticResource HeaderTitle}" />
                    <BoxView Grid.Row="1" Style="{StaticResource SectionRule}" Margin="0,10,0,0" />
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Padding="18,12" StrokeShape="RoundRectangle 8" StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding ExibirAlunos}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource PrimaryDark}}" />
                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource PrimaryDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelecionarAlunosCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="&#xe7fd;" FontFamily="MaterialIcons" FontSize="21"
                                   TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource Gold}}"
                                   VerticalTextAlignment="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding ExibirAlunos}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Grid.Column="1" Text="{helpers:Translate Students}" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource Gold}}"
                                   VerticalTextAlignment="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding ExibirAlunos}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Padding="18,12" StrokeShape="RoundRectangle 8" StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding ExibirAlunos}" Value="False">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource PrimaryDark}}" />
                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource PrimaryDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelecionarColaboradoresCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="&#xea67;" FontFamily="MaterialIcons" FontSize="21"
                                   TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource Gold}}"
                                   VerticalTextAlignment="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding ExibirAlunos}" Value="False">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Grid.Column="1" Text="{helpers:Translate Employees}" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource Gold}}"
                                   VerticalTextAlignment="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding ExibirAlunos}" Value="False">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                    </Border>
                </Grid>

                <Border Style="{StaticResource FlatSection}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{helpers:Translate FindPerson}" Style="{StaticResource CardTitle}" />
                        <Entry Text="{Binding SearchText}" Placeholder="{helpers:Translate SearchNameCpf}" />
                        <CollectionView ItemsSource="{Binding Pessoas}" SelectedItem="{Binding SelectedPessoa}"
                                        SelectionMode="Single" HeightRequest="210">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PessoaAcessoItem">
                                    <Border Margin="0,4" Padding="14,10" StrokeThickness="1" StrokeShape="RoundRectangle 8"
                                            Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark=#24221F}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnPessoaTapped" />
                                        </Border.GestureRecognizers>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="Normal" />
                                                <VisualState Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource PrimaryDark}}" />
                                                        <Setter Property="StrokeThickness" Value="2" />
                                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFF8EA, Dark=#30291D}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Grid ColumnDefinitions="54,*,Auto" ColumnSpacing="14">
                                            <Border HeightRequest="48" WidthRequest="48" StrokeThickness="0"
                                                    BackgroundColor="{AppThemeBinding Light=#F0ECE6, Dark=#302E2A}"
                                                    StrokeShape="RoundRectangle 24">
                                                <Label Text="&#xe7fd;" FontFamily="MaterialIcons" FontSize="22"
                                                       TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource PrimaryDark}}"
                                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                                <Label Text="{Binding Nome}" FontAttributes="Bold" FontSize="15" />
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                                    <Label Text="&#xe8a1;" FontFamily="MaterialIcons" FontSize="15"
                                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                                    <Label Grid.Column="1" Text="{Binding CpfFormatado}" Style="{StaticResource MutedText}" />
                                                </Grid>
                                            </VerticalStackLayout>
                                            <Border Grid.Column="2" Padding="12,5" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                                                    Stroke="{AppThemeBinding Light=#2E7D32, Dark={StaticResource PrimaryDark}}"
                                                    BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#30291D}"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding Tipo}" FontSize="11"
                                                       TextColor="{AppThemeBinding Light=#1B5E20, Dark={StaticResource PrimaryDark}}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource FlatSection}" IsVisible="{Binding HasSelectedPessoa}">
                    <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto" ColumnSpacing="18" RowSpacing="16">
                        <Border HeightRequest="82" WidthRequest="82" StrokeThickness="1" StrokeShape="RoundRectangle 41">
                            <Grid>
                                <Label Text="&#xe7fd;" FontFamily="MaterialIcons" FontSize="38"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                <Image Source="{Binding SelectedFoto}" Aspect="AspectFill" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding SelectedPessoa.Nome}" Style="{StaticResource CardTitle}" />
                            <Label Text="{Binding SelectedCpf}" Style="{StaticResource MutedText}" />
                            <Label Text="{Binding StatusSelecionado}" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gold}}" />
                        </VerticalStackLayout>
                        <Button Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ActionButtonText}"
                                Command="{Binding RegistrarMovimentacaoCommand}" Style="{StaticResource ButtonPrimary}" />
                    </Grid>
                </Border>

                <Border IsVisible="{Binding HasFeedback}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="14">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding FeedbackIsSuccess}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E8F5E9, Dark=#173A20}" />
                            <Setter Property="Stroke" Value="#2E7D32" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding FeedbackIsSuccess}" Value="False">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFEBEE, Dark=#421E22}" />
                            <Setter Property="Stroke" Value="#C62828" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="{Binding FeedbackMessage}" FontAttributes="Bold">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding FeedbackIsSuccess}" Value="True">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=#1B5E20, Dark=#A5D6A7}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding FeedbackIsSuccess}" Value="False">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=#B71C1C, Dark=#FFCDD2}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <Border Style="{StaticResource FlatSection}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding PainelMovimentacoesTitulo}" Style="{StaticResource CardTitle}" />
                        <Border Padding="12,0" StrokeThickness="1" StrokeShape="RoundRectangle 7"
                                Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark=#24221F}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                <Label Text="&#xe8b6;" FontFamily="MaterialIcons" FontSize="20"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                       VerticalTextAlignment="Center" />
                                <Entry Grid.Column="1" Text="{Binding SearchMovimentacoesText}"
                                       Placeholder="Pesquisar nome nos acessos de hoje" />
                            </Grid>
                        </Border>
                        <CollectionView ItemsSource="{Binding MovimentacoesHoje}" EmptyView="{helpers:Translate NoAccessToday}"
                                        HeightRequest="280" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:MovimentacaoAcessoItem">
                                    <Border Margin="0,4" Padding="12,9" StrokeThickness="1" StrokeShape="RoundRectangle 7"
                                            Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark=#24221F}">
                                        <Grid ColumnDefinitions="*,Auto,70" ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="{Binding Nome}" FontAttributes="Bold" />
                                                <Label Text="{Binding Tipo}" Style="{StaticResource MutedText}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding Movimento}" VerticalTextAlignment="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                            <Label Grid.Column="2" Text="{Binding Horario}" FontAttributes="Bold"
                                                   HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
