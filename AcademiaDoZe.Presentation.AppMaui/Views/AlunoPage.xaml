<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Helpers"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.AlunoPage"
             xmlns:controls="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Controls"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             x:DataType="vm:AlunoViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <ContentPage.Resources>
        <Style TargetType="Border" x:Key="AlunoSectionCard">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFEFC, Dark=#171613}" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#D8D0C5, Dark=#38342E}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 11" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style TargetType="Border" x:Key="AlunoSectionHeader">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FAF6EF, Dark=#1B1A17}" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#E5DED4, Dark=#302D28}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="Border" x:Key="AlunoFieldBorder">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#191815}" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#BDB6AC, Dark=#5A554D}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 7" />
            <Setter Property="Padding" Value="13,1" />
            <Setter Property="MinimumHeightRequest" Value="52" />
        </Style>

        <Style TargetType="Label" x:Key="AlunoFieldIcon">
            <Setter Property="FontFamily" Value="MaterialIcons" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gold}}" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="WidthRequest" Value="30" />
        </Style>

        <Style TargetType="Button" x:Key="AlunoBackButton">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FAF6EF, Dark=#1B1A17}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gold}}" />
            <Setter Property="BorderColor" Value="{AppThemeBinding Light=#D8C6A9, Dark=#5A4422}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="FontFamily" Value="MaterialIcons" />
            <Setter Property="FontSize" Value="27" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="54" />
            <Setter Property="WidthRequest" Value="54" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="Button" x:Key="AlunoPasswordButton">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gold}}" />
            <Setter Property="FontFamily" Value="MaterialIcons" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HeightRequest" Value="42" />
            <Setter Property="WidthRequest" Value="42" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <Grid x:Name="AnimatedContent"
                  Padding="{StaticResource PageContentPadding}"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                  RowSpacing="16"
                  MaximumWidthRequest="1220"
                  HorizontalOptions="Fill">

                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="18" Margin="2,0,2,6">
                    <Button Text="&#xe5c4;"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource AlunoBackButton}"
                            VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding Title}"
                               FontFamily="OpenSansSemibold" FontAttributes="Bold"
                               FontSize="29"
                               TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource White}}" />
                        <Label Text="{helpers:Translate S_eb008927889a}"
                               Style="{StaticResource HeaderSubtitle}" FontSize="14" />
                    </VerticalStackLayout>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource AlunoSectionCard}">
                    <VerticalStackLayout Spacing="18">
                        <Border Style="{StaticResource AlunoSectionHeader}">
                            <Grid ColumnDefinitions="68,*">
                                <Border Grid.Column="0" Margin="5" Padding="0"
                                        BackgroundColor="{AppThemeBinding Light=#24211D, Dark=#3A2B12}"
                                        Stroke="{AppThemeBinding Light=#3A3530, Dark=#5B431C}"
                                        StrokeThickness="1" StrokeShape="RoundRectangle 9">
                                    <Label Text="&#xe0c8;" FontFamily="MaterialIcons" FontSize="34"
                                           TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gold}}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Margin="16,10" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{helpers:Translate S_ef764c1db7f8}" Style="{StaticResource CardTitle}" FontSize="21" />
                                    <Label Text="{helpers:Translate S_e36c27fbad71}"
                                           Style="{StaticResource HeaderSubtitle}" FontSize="13" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Grid RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{OnIdiom Phone=0, Default=184}" />
                            </Grid.ColumnDefinitions>
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{helpers:Translate S_2cbe9f1f9067}" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource AlunoFieldBorder}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Label Text="&#xe8b6;" Style="{StaticResource AlunoFieldIcon}" />
                                        <Entry Grid.Column="1"
                                               Text="{Binding Aluno.Endereco.Cep}"
                                               Style="{StaticResource FormEntry}"
                                               Placeholder="00000-000"
                                               Keyboard="Numeric" MaxLength="9"
                                               ReturnType="Search"
                                               ReturnCommand="{Binding SearchByCepCommand}" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                            <Button Grid.Row="{OnIdiom Phone=1, Default=0}"
                                    Grid.Column="{OnIdiom Phone=0, Default=1}"
                                    Text="{helpers:Translate S_804157cb11ea}"
                                    Command="{Binding SearchByCepCommand}"
                                    Style="{StaticResource ButtonPrimary}"
                                    CornerRadius="7" HeightRequest="52"
                                    VerticalOptions="End">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe8b6;" Size="22"
                                                     Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                </Button.ImageSource>
                            </Button>
                        </Grid>

                        <Border Padding="14,12"
                                BackgroundColor="{AppThemeBinding Light=#24211D, Dark=#2B2100}"
                                Stroke="{AppThemeBinding Light=#3A3530, Dark=#896D00}"
                                StrokeThickness="1" StrokeShape="RoundRectangle 7"
                                IsVisible="{Binding HasNoEnderecoVinculado}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Text="&#xe002;" FontFamily="MaterialIcons" FontSize="23"
                                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark=#F5A000}" VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{helpers:Translate S_deed34404875}"
                                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark=#F3BE00}"
                                       FontSize="13" VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Padding="15,13"
                                BackgroundColor="{AppThemeBinding Light=#EAF7F0, Dark=#162C22}"
                                Stroke="{AppThemeBinding Light=#AED7C0, Dark=#2F674B}"
                                StrokeThickness="1" StrokeShape="RoundRectangle 7"
                                IsVisible="{Binding HasEnderecoVinculado}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Text="&#xe86c;" FontFamily="MaterialIcons" FontSize="24"
                                       TextColor="{StaticResource Success}" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="{helpers:Translate S_ca54c1743777}" FontFamily="OpenSansSemibold"
                                           FontAttributes="Bold" FontSize="13" TextColor="{StaticResource Success}" />
                                    <Label Text="{Binding Aluno.Endereco.Nome, StringFormat='Rua: {0}'}" FontSize="13" />
                                    <Label Text="{Binding Aluno.Endereco.Bairro, StringFormat='Bairro: {0}'}"
                                           Style="{StaticResource MutedText}" FontSize="12" />
                                    <Label Text="{Binding Aluno.Endereco.Cidade, StringFormat='Cidade: {0}'}"
                                           Style="{StaticResource MutedText}" FontSize="12" />
                                    <Label Text="{Binding Aluno.Endereco.Estado, StringFormat='Estado: {0}'}"
                                           Style="{StaticResource MutedText}" FontSize="12" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Grid RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{OnIdiom Phone=0, Default=*}" />
                            </Grid.ColumnDefinitions>
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{helpers:Translate S_1d91f4b8d8d6}" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource AlunoFieldBorder}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Label Text="&#xe88a;" Style="{StaticResource AlunoFieldIcon}" />
                                        <Entry Grid.Column="1" Text="{Binding Aluno.Numero}"
                                               Style="{StaticResource FormEntry}"
                                               Placeholder="{helpers:Translate S_1d91f4b8d8d6}" MaxLength="20" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="{OnIdiom Phone=1, Default=0}"
                                                 Grid.Column="{OnIdiom Phone=0, Default=1}" Spacing="5">
                                <Label Text="{helpers:Translate S_ba75e2e6719b}" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource AlunoFieldBorder}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Label Text="&#xe873;" Style="{StaticResource AlunoFieldIcon}" />
                                        <Entry Grid.Column="1" Text="{Binding Aluno.Complemento}"
                                               Style="{StaticResource FormEntry}"
                                               Placeholder="{helpers:Translate S_2f4cfad71d36}" MaxLength="50" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource AlunoSectionCard}">
                    <VerticalStackLayout Spacing="16">
                        <Border Style="{StaticResource AlunoSectionHeader}">
                            <Grid ColumnDefinitions="68,*,Auto">
                                <Border Grid.Column="0" Margin="5" Padding="0"
                                        BackgroundColor="{AppThemeBinding Light=#24211D, Dark=#3A2B12}"
                                        Stroke="{AppThemeBinding Light=#3A3530, Dark=#5B431C}"
                                        StrokeThickness="1" StrokeShape="RoundRectangle 9">
                                    <Label Text="&#xe7fd;" FontFamily="MaterialIcons" FontSize="34"
                                           TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gold}}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Margin="16,10" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{helpers:Translate S_d54d68a7fe9a}" Style="{StaticResource CardTitle}" FontSize="21" />
                                    <Label Text="{helpers:Translate S_8dcdc90b9160}"
                                           Style="{StaticResource HeaderSubtitle}" FontSize="13" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" Margin="10" Padding="11,5"
                                        IsVisible="{Binding IsEditMode}"
                                        BackgroundColor="{AppThemeBinding Light=#F0DFBF, Dark=#3A2B12}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 8">
                                    <Label Text="{Binding Aluno.Id, StringFormat='ID {0}'}"
                                           FontFamily="OpenSansSemibold" FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gold}}" />
                                </Border>
                            </Grid>
                        </Border>

                        <Grid RowDefinitions="Auto,Auto" ColumnSpacing="22" RowSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{OnIdiom Phone=*, Default=214}" />
                                <ColumnDefinition Width="{OnIdiom Phone=0, Default=*}" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Padding="8"
                                    BackgroundColor="{AppThemeBinding Light=#FAF6EF, Dark=#1B1A17}"
                                    Stroke="{AppThemeBinding Light=#D8C6A9, Dark=#5A4422}"
                                    StrokeThickness="1" StrokeShape="RoundRectangle 8">
                                <VerticalStackLayout Spacing="9">
                                    <Border HeightRequest="146" WidthRequest="146" Padding="0"
                                            HorizontalOptions="Center" Margin="0,10,0,2"
                                            BackgroundColor="{AppThemeBinding Light=#24211D, Dark=#292620}"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 73">
                                        <Grid>
                                            <Label Text="&#xe7fd;" FontFamily="MaterialIcons" FontSize="62"
                                                   HorizontalOptions="Center" VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gold}}" />
                                            <Image Source="{Binding Aluno.Foto, Converter={StaticResource FotoToImageSourceConverter}}"
                                                   Aspect="AspectFill" HeightRequest="146" WidthRequest="146" />
                                        </Grid>
                                    </Border>

                                    <Button Text="{helpers:Translate S_03541389dff4}" Command="{Binding CapturePhotoCommand}"
                                            Style="{StaticResource ButtonPrimary}"
                                            CornerRadius="7" HeightRequest="44">
                                        <Button.ImageSource>
                                            <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe3b0;" Size="18"
                                                             Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                        </Button.ImageSource>
                                    </Button>
                                    <Button Text="{helpers:Translate S_82670a3e0332}" Command="{Binding PickPhotoCommand}"
                                            Style="{StaticResource ButtonSecondary}"
                                            CornerRadius="7" HeightRequest="44">
                                        <Button.ImageSource>
                                            <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe413;" Size="18"
                                                             Color="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource White}}" />
                                        </Button.ImageSource>
                                    </Button>
                                    <Button Text="{helpers:Translate S_4f88b73b9d17}" Command="{Binding RemovePhotoCommand}"
                                            IsVisible="{Binding HasFoto}"
                                            Style="{StaticResource ButtonDanger}"
                                            CornerRadius="7" WidthRequest="-1" HeightRequest="42" />

                                    <Label Text="{helpers:Translate S_79cf97c8fb90}"
                                           IsVisible="{Binding HasNoFoto}"
                                           Style="{StaticResource MutedText}" FontSize="11"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="{helpers:Translate S_d4900d16e162}"
                                           IsVisible="{Binding HasFoto}"
                                           TextColor="{StaticResource Success}"
                                           FontFamily="OpenSansSemibold" FontSize="11"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <VerticalStackLayout Grid.Row="{OnIdiom Phone=1, Default=0}"
                                                 Grid.Column="{OnIdiom Phone=0, Default=1}"
                                                 Spacing="11">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="{helpers:Translate S_13030dd962f4}" Style="{StaticResource FieldLabel}" />
                                    <Border Style="{StaticResource AlunoFieldBorder}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Label Text="&#xe7fd;" Style="{StaticResource AlunoFieldIcon}" />
                                            <Entry Grid.Column="1" Text="{Binding Aluno.Nome}"
                                                   Style="{StaticResource FormEntry}"
                                                   Placeholder="{helpers:Translate S_695fc3f31688}" MaxLength="150" />
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>

                                <Grid RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{OnIdiom Phone=0, Default=*}" />
                                    </Grid.ColumnDefinitions>
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="{helpers:Translate S_9a9bf276b82f}" Style="{StaticResource FieldLabel}" />
                                        <Border Style="{StaticResource AlunoFieldBorder}">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <Label Text="&#xe8a6;" Style="{StaticResource AlunoFieldIcon}" />
                                                <Entry Grid.Column="1" Text="{Binding Aluno.Cpf}"
                                                       Style="{StaticResource FormEntry}"
                                                       Placeholder="000.000.000-00" Keyboard="Numeric"
                                                       MaxLength="14" IsReadOnly="{Binding IsEditMode}" />
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="{OnIdiom Phone=1, Default=0}"
                                                         Grid.Column="{OnIdiom Phone=0, Default=1}" Spacing="5">
                                        <Label Text="{helpers:Translate S_d631e8cfef7a}" Style="{StaticResource FieldLabel}" />
                                        <controls:InAppDatePicker Date="{Binding Aluno.DataNascimento, Mode=TwoWay}" />
                                    </VerticalStackLayout>
                                </Grid>

                                <Grid RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{OnIdiom Phone=0, Default=*}" />
                                    </Grid.ColumnDefinitions>
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="{helpers:Translate S_04e0410282ed}" Style="{StaticResource FieldLabel}" />
                                        <Border Style="{StaticResource AlunoFieldBorder}">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <Label Text="&#xe0cd;" Style="{StaticResource AlunoFieldIcon}" />
                                                <Entry Grid.Column="1" Text="{Binding Aluno.Telefone}"
                                                       Style="{StaticResource FormEntry}"
                                                       Placeholder="(00) 00000-0000" Keyboard="Telephone" MaxLength="15" />
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="{OnIdiom Phone=1, Default=0}"
                                                         Grid.Column="{OnIdiom Phone=0, Default=1}" Spacing="5">
                                        <Label Text="{helpers:Translate S_0d01e2e86669}" Style="{StaticResource FieldLabel}" />
                                        <Border Style="{StaticResource AlunoFieldBorder}">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <Label Text="&#xe0be;" Style="{StaticResource AlunoFieldIcon}" />
                                                <Entry Grid.Column="1" Text="{Binding Aluno.Email}"
                                                       Style="{StaticResource FormEntry}"
                                                       Placeholder="{helpers:Translate S_960109973683}" Keyboard="Email" MaxLength="100" />
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>

                                <Grid RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{OnIdiom Phone=0, Default=*}" />
                                    </Grid.ColumnDefinitions>
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="{helpers:Translate S_deba0172511d}" Style="{StaticResource FieldLabel}" />
                                        <Border Style="{StaticResource AlunoFieldBorder}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                <Label Text="&#xe897;" Style="{StaticResource AlunoFieldIcon}" />
                                                <Entry Grid.Column="1" Text="{Binding Aluno.Senha}"
                                                       Style="{StaticResource FormEntry}"
                                                       Placeholder="{helpers:Translate S_0df87d977551}"
                                                       IsPassword="{Binding IsSenhaOculta}" MaxLength="50" />
                                                <Button Grid.Column="2" Text="{Binding SenhaVisibilityIcon}"
                                                        Command="{Binding ToggleSenhaVisibilityCommand}"
                                                        Style="{StaticResource AlunoPasswordButton}" />
                                            </Grid>
                                        </Border>
                                        <Label Text="{helpers:Translate S_824300cb006d}"
                                               IsVisible="{Binding IsEditMode}"
                                               Style="{StaticResource MutedText}" FontSize="11" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="{OnIdiom Phone=1, Default=0}"
                                                         Grid.Column="{OnIdiom Phone=0, Default=1}" Spacing="5">
                                        <Label Text="{helpers:Translate S_9c469e53fd34}" Style="{StaticResource FieldLabel}" />
                                        <Border Style="{StaticResource AlunoFieldBorder}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                <Label Text="&#xe897;" Style="{StaticResource AlunoFieldIcon}" />
                                                <Entry Grid.Column="1" Text="{Binding ConfirmarSenha}"
                                                       Style="{StaticResource FormEntry}"
                                                       Placeholder="{helpers:Translate S_85a9f1a88a5e}"
                                                       IsPassword="{Binding IsConfirmarSenhaOculta}" MaxLength="50" />
                                                <Button Grid.Column="2" Text="{Binding ConfirmarSenhaVisibilityIcon}"
                                                        Command="{Binding ToggleConfirmarSenhaVisibilityCommand}"
                                                        Style="{StaticResource AlunoPasswordButton}" />
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="3" Padding="15,12"
                        BackgroundColor="{AppThemeBinding Light=#FCEAE8, Dark=#331A18}"
                        Stroke="{AppThemeBinding Light=#DCA9A5, Dark=#713B36}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 8"
                        IsVisible="{Binding HasValidationErrors}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Text="&#xe000;" FontFamily="MaterialIcons" FontSize="23"
                               TextColor="{StaticResource Magenta}" VerticalOptions="Start" />
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="{helpers:Translate S_ef9a21e2f662}"
                                   FontFamily="OpenSansSemibold" FontAttributes="Bold"
                                   FontSize="13" TextColor="{StaticResource Magenta}" />
                            <Label Text="{Binding ValidationMessage}"
                                   FontSize="12" LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light=#702D29, Dark=#F0AAA4}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,0,0,6">
                    <Label Text="{helpers:Translate S_5e6e31464210}"
                           Style="{StaticResource MutedText}" FontSize="12"
                           VerticalTextAlignment="Center" />
                    <Button Grid.Column="1" Text="{helpers:Translate S_c111e0ab9ddb}"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource ButtonSecondary}"
                            CornerRadius="7" WidthRequest="134" HeightRequest="50" />
                    <Button Grid.Column="2" Text="{helpers:Translate S_fe4755da101e}"
                            Command="{Binding SaveAlunoCommand}"
                            Style="{StaticResource ButtonPrimary}"
                            CornerRadius="7" WidthRequest="182" HeightRequest="50">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe161;" Size="21"
                                             Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                        </Button.ImageSource>
                    </Button>
                </Grid>
            </Grid>
        </ScrollView>

        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#88000000" ZIndex="20">
            <Border Padding="24,18"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark=#1D1B18}"
                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark=#4A443B}"
                    StrokeThickness="1" StrokeShape="RoundRectangle 11">
                <HorizontalStackLayout Spacing="13">
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gold}}"
                                       VerticalOptions="Center" />
                    <Label Text="{helpers:Translate S_2e65a4197f3f}" FontFamily="OpenSansSemibold"
                           FontAttributes="Bold" VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
