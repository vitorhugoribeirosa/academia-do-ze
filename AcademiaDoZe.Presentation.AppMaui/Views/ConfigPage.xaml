<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Helpers"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.ConfigPage"
             Title="{helpers:Translate S_871f24c4cdaf}">

    <ContentPage.Resources>
        <Style x:Key="LanguageOptionCard" TargetType="Border">
            <Setter Property="BackgroundColor"
                    Value="{AppThemeBinding Light=#FBF9F6, Dark=#181715}"/>
            <Setter Property="Stroke"
                    Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 8"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="MinimumWidthRequest" Value="190"/>
            <Setter Property="HeightRequest" Value="96"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="LanguageOptionCardSelected"
               TargetType="Border"
               BasedOn="{StaticResource LanguageOptionCard}">
            <Setter Property="BackgroundColor"
                    Value="{AppThemeBinding Light=#FFF4DE, Dark=#2D271D}"/>
            <Setter Property="Stroke"
                    Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout x:Name="AnimatedContent"
                             Padding="32,26,32,40"
                             Spacing="26"
                             MaximumWidthRequest="940"
                             HorizontalOptions="Fill">

            <VerticalStackLayout Spacing="6">
                <Label Text="{helpers:Translate S_871f24c4cdaf}" Style="{StaticResource HeaderTitle}"/>
                <Label Text="{helpers:Translate S_67db423c1963}" Style="{StaticResource HeaderSubtitle}"/>
                <BoxView Style="{StaticResource SectionRule}" Margin="0,10,0,0"/>
            </VerticalStackLayout>

            <Border Style="{StaticResource FlatSection}">
                <VerticalStackLayout Spacing="18">
                    <Grid ColumnDefinitions="*,380" ColumnSpacing="24">
                        <Grid ColumnDefinitions="34,*" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Text="&#xe40a;"
                                   FontFamily="MaterialIcons"
                                   FontSize="22"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                   VerticalTextAlignment="Center"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="{helpers:Translate S_8ecb9f1828bd}" Style="{StaticResource CardTitle}"/>
                                <Label Text="{helpers:Translate S_3596d3f18f8e}"
                                       Style="{StaticResource MutedText}" FontSize="12"/>
                            </VerticalStackLayout>
                        </Grid>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="{helpers:Translate S_c358926e5acc}" Style="{StaticResource FieldLabel}"/>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                <Button x:Name="TemaClaroButton"
                                        Text="{helpers:Translate S_21f72c3cc4b9}"
                                        CommandParameter="0"
                                        Clicked="OnTemaOptionClicked"
                                        Style="{StaticResource ButtonSecondary}"/>
                                <Button x:Name="TemaEscuroButton"
                                        Grid.Column="1"
                                        Text="{helpers:Translate S_0d7f97c38367}"
                                        CommandParameter="1"
                                        Clicked="OnTemaOptionClicked"
                                        Style="{StaticResource ButtonSecondary}"/>
                                <Button x:Name="TemaSistemaButton"
                                        Grid.Column="2"
                                        Text="{helpers:Translate S_c004160342cd}"
                                        CommandParameter="2"
                                        Clicked="OnTemaOptionClicked"
                                        Style="{StaticResource ButtonSecondary}"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView Style="{StaticResource SectionRule}"/>
                    <HorizontalStackLayout HorizontalOptions="End" Spacing="10">
                        <Button Text="{helpers:Translate S_c111e0ab9ddb}" Clicked="OnCancelarClicked"
                                Style="{StaticResource ButtonSecondary}" WidthRequest="112"/>
                        <Button x:Name="SalvarTemaButton" Text="{helpers:Translate S_08191e9ac646}"
                                Clicked="OnSalvarTemaClicked"
                                Style="{StaticResource ButtonPrimary}" WidthRequest="126"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource FlatSection}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="34,*" ColumnSpacing="10">
                        <Label Text="&#xe894;"
                               FontFamily="MaterialIcons"
                               FontSize="22"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                               VerticalTextAlignment="Center"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="{helpers:Translate S_ca33ec318e91}" Style="{StaticResource CardTitle}"/>
                            <Label Text="{helpers:Translate S_98ee80bdd525}"
                                   Style="{StaticResource MutedText}" FontSize="12"/>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView Style="{StaticResource SectionRule}"/>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="{helpers:Translate S_6f389f0070a4}"
                               Style="{StaticResource FieldLabel}"/>

                        <FlexLayout Direction="Row"
                                    Wrap="Wrap"
                                    AlignItems="Stretch"
                                    JustifyContent="SpaceBetween">
                            <Border x:Name="CulturaPtBrCard"
                                    Style="{StaticResource LanguageOptionCard}"
                                    FlexLayout.Basis="30%">
                                <Grid RowDefinitions="32,Auto,Auto" RowSpacing="2">
                                    <Border BackgroundColor="{AppThemeBinding Light=#F1E6D9, Dark=#3A3024}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 5"
                                            HeightRequest="28"
                                            WidthRequest="38"
                                            HorizontalOptions="Start">
                                        <Label Text="PT"
                                               FontFamily="OpenSansSemibold"
                                               FontAttributes="Bold"
                                               FontSize="11"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"/>
                                    </Border>
                                    <Label x:Name="CulturaPtBrCheck"
                                           Text="&#xe5ca;"
                                           FontFamily="MaterialIcons"
                                           FontSize="21"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center"
                                           IsVisible="False"/>
                                    <Label Grid.Row="1"
                                           Text="Português"
                                           Style="{StaticResource FieldLabel}"
                                           FontSize="15"/>
                                    <Label Grid.Row="2"
                                           Text="Brasil · pt-BR"
                                           Style="{StaticResource MutedText}"
                                           FontSize="11"/>
                                    <Button Grid.RowSpan="3"
                                            BackgroundColor="Transparent"
                                            BorderWidth="0"
                                            Padding="0"
                                            CommandParameter="pt-BR"
                                            Clicked="OnCulturaOptionClicked"
                                            SemanticProperties.Description="Português do Brasil"/>
                                </Grid>
                            </Border>

                            <Border x:Name="CulturaEnUsCard"
                                    Style="{StaticResource LanguageOptionCard}"
                                    FlexLayout.Basis="30%">
                                <Grid RowDefinitions="32,Auto,Auto" RowSpacing="2">
                                    <Border BackgroundColor="{AppThemeBinding Light=#E8EEF8, Dark=#232C3B}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 5"
                                            HeightRequest="28"
                                            WidthRequest="38"
                                            HorizontalOptions="Start">
                                        <Label Text="EN"
                                               FontFamily="OpenSansSemibold"
                                               FontAttributes="Bold"
                                               FontSize="11"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"/>
                                    </Border>
                                    <Label x:Name="CulturaEnUsCheck"
                                           Text="&#xe5ca;"
                                           FontFamily="MaterialIcons"
                                           FontSize="21"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center"
                                           IsVisible="False"/>
                                    <Label Grid.Row="1"
                                           Text="English"
                                           Style="{StaticResource FieldLabel}"
                                           FontSize="15"/>
                                    <Label Grid.Row="2"
                                           Text="United States · en-US"
                                           Style="{StaticResource MutedText}"
                                           FontSize="11"/>
                                    <Button Grid.RowSpan="3"
                                            BackgroundColor="Transparent"
                                            BorderWidth="0"
                                            Padding="0"
                                            CommandParameter="en-US"
                                            Clicked="OnCulturaOptionClicked"
                                            SemanticProperties.Description="English, United States"/>
                                </Grid>
                            </Border>

                            <Border x:Name="CulturaEsEsCard"
                                    Style="{StaticResource LanguageOptionCard}"
                                    FlexLayout.Basis="30%">
                                <Grid RowDefinitions="32,Auto,Auto" RowSpacing="2">
                                    <Border BackgroundColor="{AppThemeBinding Light=#F9E9E2, Dark=#3A2924}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 5"
                                            HeightRequest="28"
                                            WidthRequest="38"
                                            HorizontalOptions="Start">
                                        <Label Text="ES"
                                               FontFamily="OpenSansSemibold"
                                               FontAttributes="Bold"
                                               FontSize="11"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"/>
                                    </Border>
                                    <Label x:Name="CulturaEsEsCheck"
                                           Text="&#xe5ca;"
                                           FontFamily="MaterialIcons"
                                           FontSize="21"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center"
                                           IsVisible="False"/>
                                    <Label Grid.Row="1"
                                           Text="Español"
                                           Style="{StaticResource FieldLabel}"
                                           FontSize="15"/>
                                    <Label Grid.Row="2"
                                           Text="España · es-ES"
                                           Style="{StaticResource MutedText}"
                                           FontSize="11"/>
                                    <Button Grid.RowSpan="3"
                                            BackgroundColor="Transparent"
                                            BorderWidth="0"
                                            Padding="0"
                                            CommandParameter="es-ES"
                                            Clicked="OnCulturaOptionClicked"
                                            SemanticProperties.Description="Español de España"/>
                                </Grid>
                            </Border>
                        </FlexLayout>

                        <HorizontalStackLayout HorizontalOptions="Start">
                            <Button Text="{helpers:Translate S_575c80a8ffc2}"
                                    Clicked="OnSalvarCulturaClicked"
                                    Style="{StaticResource ButtonPrimary}"
                                    MinimumWidthRequest="170"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource FlatSection}" Padding="0">
                <Grid RowDefinitions="4,Auto,Auto,Auto">
                    <BoxView BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>

                    <Grid Grid.Row="1"
                          Padding="20,18"
                          ColumnDefinitions="42,*"
                          ColumnSpacing="12">
                        <Border BackgroundColor="{AppThemeBinding Light=#F1E6D9, Dark=#302820}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 5"
                                HeightRequest="42"
                                WidthRequest="42">
                            <Label Text="&#xe1db;"
                                   FontFamily="MaterialIcons"
                                   FontSize="22"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="{helpers:Translate S_ed06f98a2c44}" Style="{StaticResource CardTitle}"/>
                            <Label Text="{helpers:Translate S_a46f285634de}"
                                   Style="{StaticResource MutedText}" FontSize="12"/>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView Grid.Row="2"
                             Style="{StaticResource SectionRule}"
                             Margin="20,0"/>

                    <VerticalStackLayout Grid.Row="3" Padding="20" Spacing="18">
                        <Grid>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{helpers:Translate S_f675553b8ecc}" Style="{StaticResource FieldLabel}"/>
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <Button x:Name="BancoSqliteButton"
                                            Text="{helpers:Translate S_9f09ccbd1cfb}"
                                            CommandParameter="0"
                                            Clicked="OnDatabaseOptionClicked"
                                            Style="{StaticResource ButtonSecondary}"/>
                                    <Button x:Name="BancoMySqlButton"
                                            Grid.Column="1"
                                            Text="{helpers:Translate S_deaa0c393a66}"
                                            CommandParameter="1"
                                            Clicked="OnDatabaseOptionClicked"
                                            Style="{StaticResource ButtonSecondary}"/>
                                    <Button x:Name="BancoSqlServerButton"
                                            Grid.Column="2"
                                            Text="{helpers:Translate S_725d4af7c0a6}"
                                            CommandParameter="2"
                                            Clicked="OnDatabaseOptionClicked"
                                            Style="{StaticResource ButtonSecondary}"/>
                                </Grid>
                            </VerticalStackLayout>

                        </Grid>

                        <Border BackgroundColor="{AppThemeBinding Light=#FBF9F6, Dark=#181715}"
                                Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 5"
                                Padding="18">
                            <VerticalStackLayout Spacing="16">
                                <Grid ColumnDefinitions="28,*" ColumnSpacing="8">
                                    <Label Text="&#xe875;"
                                           FontFamily="MaterialIcons"
                                           FontSize="20"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                           VerticalTextAlignment="Center"/>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                                        <Label Text="{helpers:Translate S_f2dcd0f9b98f}"
                                               FontFamily="OpenSansSemibold"
                                               FontAttributes="Bold"
                                               FontSize="15"/>
                                        <Label Text="{helpers:Translate S_a3622915f1e2}"
                                               Style="{StaticResource MutedText}"
                                               FontSize="11"/>
                                    </VerticalStackLayout>
                                </Grid>

                                <BoxView Style="{StaticResource SectionRule}"/>

                                <VerticalStackLayout x:Name="SqliteContainer" Spacing="6">
                                    <Label Text="{helpers:Translate S_93dee0568df5}" Style="{StaticResource FieldLabel}"/>
                                    <Border Style="{StaticResource FormFieldBorder}">
                                        <Grid ColumnDefinitions="28,*" ColumnSpacing="6">
                                            <Label Text="&#xe2c8;"
                                                   FontFamily="MaterialIcons"
                                                   FontSize="19"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                                                   VerticalTextAlignment="Center"/>
                                            <Entry x:Name="SqliteCaminhoEntry"
                                                   Grid.Column="1"
                                                   Style="{StaticResource FormEntry}"
                                                   Placeholder="{helpers:Translate S_5f4efa44b606}"/>
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>

                                <Grid x:Name="ServidorBancoGrid" ColumnDefinitions="*,*" ColumnSpacing="14">
                                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                                        <Label Text="{helpers:Translate S_07728991147d}" Style="{StaticResource FieldLabel}"/>
                                        <Border Style="{StaticResource FormFieldBorder}">
                                            <Entry x:Name="ServidorEntry"
                                                   Style="{StaticResource FormEntry}"
                                                   Placeholder="{helpers:Translate S_d80faba8a4d8}"/>
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                                        <Label Text="{helpers:Translate S_67a4de350575}" Style="{StaticResource FieldLabel}"/>
                                        <Border Style="{StaticResource FormFieldBorder}">
                                            <Entry x:Name="BancoEntry"
                                                   Style="{StaticResource FormEntry}"
                                                   Placeholder="{helpers:Translate S_dd04852e91a9}"/>
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>

                                <Grid x:Name="CredenciaisGrid" ColumnDefinitions="*,*" ColumnSpacing="14">
                                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                                        <Label Text="{helpers:Translate S_f32c134523d4}" Style="{StaticResource FieldLabel}"/>
                                        <Border Style="{StaticResource FormFieldBorder}">
                                            <Entry x:Name="UsuarioEntry"
                                                   Style="{StaticResource FormEntry}"
                                                   Placeholder="{helpers:Translate S_2067a963e355}"/>
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                                        <Label Text="{helpers:Translate S_deba0172511d}" Style="{StaticResource FieldLabel}"/>
                                        <Border Style="{StaticResource FormFieldBorder}">
                                            <Entry x:Name="SenhaEntry"
                                                   Style="{StaticResource FormEntry}"
                                                   Placeholder="{helpers:Translate S_423cd0ebcd94}"
                                                   IsPassword="True"/>
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>

                            </VerticalStackLayout>
                        </Border>

                        <BoxView Style="{StaticResource SectionRule}"/>
                        <HorizontalStackLayout HorizontalOptions="End" Spacing="10">
                            <Button Text="Limpar registros de acesso"
                                    Clicked="OnLimparAcessosClicked"
                                    Style="{StaticResource ButtonDanger}" />
                            <Button Text="{helpers:Translate S_c111e0ab9ddb}"
                                    Clicked="OnCancelarClicked"
                                    Style="{StaticResource ButtonSecondary}"
                                    WidthRequest="112"/>
                            <Button x:Name="SalvarBancoButton"
                                    Text="{helpers:Translate S_03019216fed9}"
                                    Clicked="OnSalvarBancoClicked"
                                    Style="{StaticResource ButtonPrimary}"
                                    WidthRequest="200">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="MaterialIcons"
                                                     Glyph="&#xe161;"
                                                     Size="18"
                                                     Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"/>
                                </Button.ImageSource>
                            </Button>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
