<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Helpers"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.MatriculaPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             xmlns:controls="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Controls"
             x:DataType="vm:MatriculaViewModel"
             Title="{Binding Title}">
    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSourceConverter" />
        <converters:EnumDisplayConverter x:Key="EnumDisplay" />
        <Style TargetType="Border" x:Key="MatriculaSectionCard" BasedOn="{StaticResource FlatSection}">
            <Setter Property="Padding" Value="22" />
        </Style>
        <Style TargetType="Border" x:Key="MatriculaFieldBorder" BasedOn="{StaticResource FormFieldBorder}">
            <Setter Property="Padding" Value="13,1" />
            <Setter Property="MinimumHeightRequest" Value="52" />
        </Style>
    </ContentPage.Resources>

    <Grid x:Name="AnimatedContent">
        <ScrollView>
            <VerticalStackLayout Padding="{StaticResource PageContentPadding}"
                                 Spacing="18"
                                 MaximumWidthRequest="1040"
                                 HorizontalOptions="Fill">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Title}" Style="{StaticResource HeaderTitle}" />
                        <Label Text="{helpers:Translate S_a834f7c7ea0f}"
                               Style="{StaticResource HeaderSubtitle}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" Padding="11,6" IsVisible="{Binding IsEditMode}"
                            BackgroundColor="{AppThemeBinding Light=#F0DFBF, Dark=#3A2B12}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 8"
                            VerticalOptions="Center">
                        <Label Text="{Binding Matricula.Id, StringFormat='ID {0}'}"
                               FontFamily="OpenSansSemibold" FontAttributes="Bold" FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gold}}" />
                    </Border>
                </Grid>

                <Border Style="{StaticResource MatriculaSectionCard}">
                    <VerticalStackLayout Spacing="15">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border HeightRequest="44" WidthRequest="44" Padding="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark=#3A2B12}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 9">
                                <Label Text="&#xe7fd;" FontFamily="MaterialIcons" FontSize="23"
                                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gold}}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{helpers:Translate S_5da578dfb8be}" Style="{StaticResource CardTitle}" />
                                <Label Text="{helpers:Translate S_6ef280041542}"
                                       Style="{StaticResource MutedText}" FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Border Style="{StaticResource MatriculaFieldBorder}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Text="&#xe8a6;" FontFamily="MaterialIcons" FontSize="21"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gold}}"
                                           VerticalTextAlignment="Center" />
                                    <Entry Grid.Column="1" Text="{Binding CpfBusca}"
                                           Style="{StaticResource FormEntry}"
                                           Placeholder="000.000.000-00" Keyboard="Numeric" MaxLength="14"
                                           IsReadOnly="{Binding IsEditMode}"
                                           ReturnCommand="{Binding SearchByCpfCommand}" />
                                </Grid>
                            </Border>
                            <Button Grid.Column="1" Text="{helpers:Translate S_a7c5478a16d0}"
                                    Command="{Binding SearchByCpfCommand}"
                                    Style="{StaticResource ButtonPrimary}"
                                    WidthRequest="152" IsVisible="{Binding HasNoAlunoVinculado}" />
                        </Grid>

                        <Border Padding="14" IsVisible="{Binding HasNoAlunoVinculado}"
                                BackgroundColor="{AppThemeBinding Light=#FFF5E2, Dark=#35270F}"
                                Stroke="{AppThemeBinding Light=#E3C98F, Dark=#6B4B17}"
                                StrokeThickness="1" StrokeShape="RoundRectangle 8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="&#xe002;" FontFamily="MaterialIcons" FontSize="21"
                                       TextColor="{StaticResource Gold}" VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{helpers:Translate S_9978531887c0}"
                                       Style="{StaticResource MutedText}" FontSize="13"
                                       VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Padding="15" IsVisible="{Binding HasAlunoVinculado}"
                                BackgroundColor="{AppThemeBinding Light=#FAF7F2, Dark=#211F1B}"
                                Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                                StrokeThickness="1" StrokeShape="RoundRectangle 10">
                            <Grid ColumnDefinitions="76,*" ColumnSpacing="16">
                                <Border HeightRequest="68" WidthRequest="68" Padding="0"
                                        Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gold}}"
                                        StrokeThickness="2" StrokeShape="RoundRectangle 34"
                                        BackgroundColor="{AppThemeBinding Light=#EEE8DE, Dark=#292620}">
                                    <Grid>
                                        <Label Text="&#xe7fd;" FontFamily="MaterialIcons" FontSize="34"
                                               HorizontalOptions="Center" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gold}}" />
                                        <Image Source="{Binding Matricula.AlunoMatricula.Foto, Converter={StaticResource FotoToImageSourceConverter}}"
                                               Aspect="AspectFill" HeightRequest="68" WidthRequest="68" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Matricula.AlunoMatricula.Nome}"
                                           Style="{StaticResource CardTitle}" FontSize="18" />
                                    <Label Text="{Binding Matricula.AlunoMatricula.Cpf, StringFormat='CPF: {0}'}"
                                           Style="{StaticResource MutedText}" FontSize="12" />
                                    <Label Text="{Binding Matricula.AlunoMatricula.DataNascimento, StringFormat='{0:d}'}"
                                           Style="{StaticResource MutedText}" FontSize="12" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Border Padding="12" IsVisible="{Binding IsMenor16}"
                                BackgroundColor="{AppThemeBinding Light=#FFF5E2, Dark=#35270F}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 8">
                            <Label Text="{helpers:Translate S_7ace54510067}"
                                   TextColor="{AppThemeBinding Light=#7A4D00, Dark=#F2C46D}"
                                   FontFamily="OpenSansSemibold" FontAttributes="Bold" FontSize="12" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource MatriculaSectionCard}">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="{helpers:Translate S_1b1f5eca7709}" Style="{StaticResource CardTitle}" />
                        <Grid RowDefinitions="Auto,Auto" ColumnSpacing="18" RowSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{helpers:Translate S_a0ad53d6de6e}" Style="{StaticResource FieldLabel}" />
                                <controls:InAppPicker ItemsSource="{Binding PlanoTipos}"
                                                      SelectedItem="{Binding PlanoSelecionado, Mode=TwoWay}"
                                                      LeadingGlyph="&#xe85d;"
                                                      Placeholder="{helpers:Translate S_c7b6db223e16}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="{helpers:Translate S_a244e3c17e32}" Style="{StaticResource FieldLabel}" />
                                <controls:InAppDatePicker Date="{Binding DataInicio, Mode=TwoWay}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="5">
                                <Label Text="{helpers:Translate S_504acaca9e8a}" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource MatriculaFieldBorder}"
                                        BackgroundColor="{AppThemeBinding Light=#EEEAE3, Dark=#24221E}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Label Text="&#xe8df;" FontFamily="MaterialIcons" FontSize="21"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gold}}"
                                               VerticalTextAlignment="Center" />
                                        <Label Grid.Column="1" Text="{Binding DataFimFormatada}"
                                               VerticalTextAlignment="Center" FontSize="15" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="3" Spacing="5">
                                <Label Text="{helpers:Translate S_a7b0c7991f6b}" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource MatriculaFieldBorder}">
                                    <Entry Text="{Binding Matricula.Objetivo}"
                                           Style="{StaticResource FormEntry}"
                                           Placeholder="{helpers:Translate S_95bc3c506e27}"
                                           MaxLength="200" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource MatriculaSectionCard}">
                    <VerticalStackLayout Spacing="13">
                        <Label Text="{helpers:Translate S_a1572ef22c8f}" Style="{StaticResource CardTitle}" />
                        <Label Text="{helpers:Translate S_84d09127c216}"
                               Style="{StaticResource MutedText}" FontSize="12" />

                        <Border Style="{StaticResource MatriculaFieldBorder}" Padding="12,0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                <Label Text="&#xe8b6;" FontFamily="MaterialIcons" FontSize="20"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                                       VerticalTextAlignment="Center" />
                                <Entry Grid.Column="1"
                                       Text="{Binding RestricaoSearchText}"
                                       Style="{StaticResource FormEntry}"
                                       Placeholder="{helpers:Translate S_d603c4e5b3b3}"
                                       ClearButtonVisibility="WhileEditing" />
                            </Grid>
                        </Border>

                        <Grid RowDefinitions="Auto,Auto" ColumnSpacing="18" RowSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{OnIdiom Phone=*, Default=1.05*}" />
                                <ColumnDefinition Width="{OnIdiom Phone=0, Default=0.95*}" />
                            </Grid.ColumnDefinitions>

                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="13">
                                <CollectionView ItemsSource="{Binding RestricoesFiltradas}"
                                                IsVisible="{Binding HasRestricoesFiltradas}"
                                                SelectionMode="None" HeightRequest="280">
                                    <CollectionView.ItemsLayout>
                                        <GridItemsLayout Orientation="Vertical" Span="1"
                                                         VerticalItemSpacing="8" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RestricaoSelectable">
                                            <Border Padding="11,7"
                                                    BackgroundColor="{AppThemeBinding Light=#FAF7F2, Dark=#211F1B}"
                                                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                                                    StrokeThickness="1" StrokeShape="RoundRectangle 7">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              VerticalOptions="Center"
                                                              Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gold}}" />
                                                    <Label Grid.Column="1"
                                                           Text="{Binding Value, Converter={StaticResource EnumDisplay}}"
                                                           VerticalTextAlignment="Center" FontSize="13" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                                <Border Padding="18" IsVisible="{Binding HasNoRestricoesFiltradas}"
                                        BackgroundColor="{AppThemeBinding Light=#FAF7F2, Dark=#211F1B}"
                                        Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                                        StrokeThickness="1" StrokeShape="RoundRectangle 7">
                                    <Label Text="{helpers:Translate S_08c7a1ac64d6}"
                                           HorizontalTextAlignment="Center"
                                           Style="{StaticResource MutedText}" />
                                </Border>

                                <VerticalStackLayout Spacing="5">
                                    <Label Text="{helpers:Translate S_8609c7ca48e6}" Style="{StaticResource FieldLabel}" />
                                    <Border Style="{StaticResource MatriculaFieldBorder}" Padding="12,7">
                                        <Editor Text="{Binding Matricula.ObservacoesRestricoes}"
                                                Placeholder="{helpers:Translate S_eb76bade10de}"
                                                AutoSize="TextChanges" MaxLength="500"
                                                MinimumHeightRequest="82" />
                                    </Border>
                                </VerticalStackLayout>

                                <Border Padding="12" IsVisible="{Binding HasRestricoes}"
                                        BackgroundColor="{AppThemeBinding Light=#FFF5E2, Dark=#35270F}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 8">
                                    <Label Text="{helpers:Translate S_19594b1413d9}"
                                           TextColor="{AppThemeBinding Light=#7A4D00, Dark=#F2C46D}"
                                           FontFamily="OpenSansSemibold" FontAttributes="Bold" FontSize="12" />
                                </Border>
                            </VerticalStackLayout>

                            <Border Grid.Row="{OnIdiom Phone=1, Default=0}"
                                    Grid.Column="{OnIdiom Phone=0, Default=1}"
                                    Padding="18"
                                    BackgroundColor="{AppThemeBinding Light=#FAF7F2, Dark=#211F1B}"
                                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                                    StrokeThickness="1" StrokeShape="RoundRectangle 9">
                                <VerticalStackLayout Spacing="14">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{helpers:Translate S_07d947143b89}" Style="{StaticResource CardTitle}" />
                                            <Label Text="{helpers:Translate S_3920c1dfdca1}"
                                                   Style="{StaticResource MutedText}" FontSize="12" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1" Padding="9,5" IsVisible="{Binding HasLaudo}"
                                                BackgroundColor="{AppThemeBinding Light=#DFF3E8, Dark=#163A2B}"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 7">
                                            <Label Text="{helpers:Translate S_8ffe782002b9}" FontFamily="OpenSansSemibold" FontAttributes="Bold"
                                                   FontSize="11" TextColor="{StaticResource Success}" />
                                        </Border>
                                    </Grid>

                                    <Border HeightRequest="230" Padding="8"
                                            BackgroundColor="{AppThemeBinding Light=#F4F0E9, Dark=#1A1815}"
                                            Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                                            StrokeThickness="1" StrokeShape="RoundRectangle 9">
                                        <Grid>
                                            <VerticalStackLayout IsVisible="{Binding HasNoLaudo}"
                                                                 HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                                                <Label Text="&#xe415;" FontFamily="MaterialIcons" FontSize="48"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}"
                                                       HorizontalTextAlignment="Center" />
                                                <Label Text="{helpers:Translate S_207b18cdf4f2}" Style="{StaticResource MutedText}" />
                                            </VerticalStackLayout>
                                            <Image IsVisible="{Binding HasLaudo}"
                                                   Source="{Binding Matricula.LaudoMedico, Converter={StaticResource FotoToImageSourceConverter}}"
                                                   Aspect="AspectFit" />
                                        </Grid>
                                    </Border>

                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                        <Button Text="{helpers:Translate S_03541389dff4}" Command="{Binding CaptureLaudoCommand}"
                                                Style="{StaticResource ButtonPrimary}" HeightRequest="46" FontSize="12" />
                                        <Button Grid.Column="1" Text="{helpers:Translate S_82670a3e0332}" Command="{Binding PickLaudoCommand}"
                                                Style="{StaticResource ButtonSecondary}" HeightRequest="46" FontSize="12" />
                                        <Button Grid.Column="2" Text="{helpers:Translate S_4bd4ea834263}" Command="{Binding RemoveLaudoCommand}"
                                                Style="{StaticResource ButtonDanger}" HeightRequest="46" FontSize="12"
                                                IsVisible="{Binding HasLaudo}" />
                                    </Grid>

                                    <Border Padding="12" IsVisible="{Binding LaudoPendente}"
                                            BackgroundColor="{AppThemeBinding Light=#FCEAE8, Dark=#331A18}"
                                            Stroke="{AppThemeBinding Light=#DCA9A5, Dark=#713B36}"
                                            StrokeThickness="1" StrokeShape="RoundRectangle 8">
                                        <Label Text="{helpers:Translate S_ac0f1750a4a7}"
                                               TextColor="{AppThemeBinding Light=#702D29, Dark=#F0AAA4}"
                                               FontFamily="OpenSansSemibold" FontAttributes="Bold" FontSize="12" />
                                    </Border>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="15,12"
                        BackgroundColor="{AppThemeBinding Light=#FCEAE8, Dark=#331A18}"
                        Stroke="{AppThemeBinding Light=#DCA9A5, Dark=#713B36}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 8"
                        IsVisible="{Binding HasValidationErrors}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Text="&#xe000;" FontFamily="MaterialIcons" FontSize="23"
                               TextColor="{StaticResource Magenta}" VerticalOptions="Start" />
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="{helpers:Translate S_ef9a21e2f662}"
                                   FontFamily="OpenSansSemibold" FontAttributes="Bold"
                                   FontSize="13" TextColor="{StaticResource Magenta}" />
                            <Label Text="{Binding ValidationMessage}"
                                   FontSize="12" LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light=#702D29, Dark=#F0AAA4}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,0,0,8">
                    <Label Text="{helpers:Translate S_927453f3cfe1}"
                           Style="{StaticResource MutedText}" FontSize="12"
                           VerticalTextAlignment="Center" />
                    <Button Grid.Column="1" Text="{helpers:Translate S_c111e0ab9ddb}"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource ButtonSecondary}"
                            WidthRequest="134" HeightRequest="50" />
                    <Button Grid.Column="2" Text="{helpers:Translate S_48aaeb843173}"
                            Command="{Binding SaveMatriculaCommand}"
                            Style="{StaticResource ButtonPrimary}"
                            WidthRequest="196" HeightRequest="50">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe161;" Size="20"
                                             Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                        </Button.ImageSource>
                    </Button>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#88000000" ZIndex="20">
            <Border Padding="24,18"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark=#1D1B18}"
                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark=#4A443B}"
                    StrokeThickness="1" StrokeShape="RoundRectangle 11">
                <HorizontalStackLayout Spacing="13">
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gold}}" />
                    <Label Text="{helpers:Translate S_2e65a4197f3f}" FontFamily="OpenSansSemibold"
                           FontAttributes="Bold" VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
