<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.ColaboradorListPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
             x:DataType="vm:ColaboradorListViewModel"
             Title="{Binding Title}">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Grid Grid.Row="0" Margin="{StaticResource ListHeaderMargin}" ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <VerticalStackLayout Spacing="5">
                <Label Text="Colaboradores" Style="{StaticResource HeaderTitle}"/>
                <Label Text="Equipe responsável pelo atendimento e funcionamento da academia."
                       Style="{StaticResource HeaderSubtitle}"/>
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="Novo colaborador"
                    Command="{Binding AddColaboradorCommand}"
                    Style="{StaticResource ButtonPrimary}"
                    WidthRequest="196"
                    VerticalOptions="Center">
                <Button.ImageSource>
                    <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe145;" Size="18"
                                     Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"/>
                </Button.ImageSource>
            </Button>
        </Grid>

        <Border Grid.Row="1"
                Margin="{StaticResource ListSideMargin}"
                Style="{StaticResource FlatSection}"
                Padding="14">
            <Grid ColumnDefinitions="134,*,98" ColumnSpacing="10">
                <Border Grid.Column="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 4"
                        HeightRequest="44"
                        Padding="12,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterSelectorTapped"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <Label Text="{Binding SelectedFilterType}" VerticalTextAlignment="Center"/>
                        <Label x:Name="FilterArrowLabel" Grid.Column="1" Text="▼" FontSize="10"
                               TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                               VerticalTextAlignment="Center"/>
                    </Grid>
                </Border>
                <Entry Grid.Column="1"
                       Text="{Binding SearchText}"
                       Placeholder="Pesquisar pelo campo selecionado"
                       ReturnType="Search"
                       ReturnCommand="{Binding SearchColaboradoresCommand}"/>
                <Button Grid.Column="2"
                        Text="Buscar"
                        Style="{StaticResource ButtonPrimary}"
                        Command="{Binding SearchColaboradoresCommand}"/>
            </Grid>
        </Border>

        <Border x:Name="FilterOptionsPanel"
                Grid.Row="1" Grid.RowSpan="3" ZIndex="10"
                IsVisible="False"
                HorizontalOptions="Start" VerticalOptions="Start"
                WidthRequest="134" Margin="42,58,0,0" Padding="4"
                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                StrokeThickness="1" StrokeShape="RoundRectangle 4">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding FilterTypes}" Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border BackgroundColor="Transparent" StrokeThickness="0"
                                HeightRequest="38" Padding="10,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer CommandParameter="{Binding .}"
                                                      Tapped="OnFilterOptionTapped"/>
                            </Border.GestureRecognizers>
                            <Label Text="{Binding .}" VerticalTextAlignment="Center"/>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="2"
              Margin="{StaticResource ListSideMargin}"
              ColumnSpacing="12"
              Padding="14,9"
              BackgroundColor="{AppThemeBinding Light=#EAE5DD, Dark=#282622}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{OnIdiom Phone=52, Default=64}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{OnIdiom Phone=0, Default=170}" />
                <ColumnDefinition Width="{OnIdiom Phone=150, Default=174}" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="1" Text="Colaborador" Style="{StaticResource FieldLabel}"/>
            <Label Grid.Column="2" Text="Trabalho" Style="{StaticResource FieldLabel}"
                   IsVisible="{OnIdiom Phone=False, Default=True}"/>
            <Label Grid.Column="3" Text="Ações" Style="{StaticResource FieldLabel}"/>
        </Grid>

        <Grid Grid.Row="3">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
                <CollectionView ItemsSource="{Binding Colaboradores}"
                                SelectionMode="None"
                                Margin="{StaticResource ListSideMargin}">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="8" Padding="24">
                            <Label Text="&#xea67;" FontFamily="MaterialIcons" FontSize="34"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                                   HorizontalOptions="Center"/>
                            <Label Text="Nenhum colaborador encontrado"
                                   HorizontalOptions="Center"
                                   FontFamily="OpenSansSemibold" FontAttributes="Bold" FontSize="17"/>
                            <Label Text="Altere a busca ou cadastre um novo colaborador."
                                   HorizontalTextAlignment="Center" Style="{StaticResource MutedText}"/>
                            <Button Text="Novo colaborador"
                                    Command="{Binding AddColaboradorCommand}"
                                    Style="{StaticResource ButtonPrimary}"
                                    WidthRequest="180" HorizontalOptions="Center" Margin="0,8,0,0"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:ColaboradorDto">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                                    StrokeThickness="1"
                                    StrokeShape="Rectangle"
                                    Padding="14,12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{OnIdiom Phone=52, Default=64}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{OnIdiom Phone=0, Default=170}" />
                                        <ColumnDefinition Width="{OnIdiom Phone=150, Default=174}" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            HeightRequest="52" WidthRequest="52" Padding="0"
                                            HorizontalOptions="Center" VerticalOptions="Center"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark=#302C27}"
                                            Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                                            StrokeShape="RoundRectangle 26">
                                        <Grid>
                                            <Label Text="&#xe7fd;" FontFamily="MaterialIcons" FontSize="25"
                                                   HorizontalOptions="Center" VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                                            <Image Source="{Binding Foto, Converter={StaticResource FotoToImageSourceConverter}}"
                                                   Aspect="AspectFill" HeightRequest="52" WidthRequest="52"/>
                                        </Grid>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding Nome}"
                                               FontFamily="OpenSansSemibold" FontAttributes="Bold" FontSize="14"/>
                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="CPF:" Style="{StaticResource MutedText}" FontSize="12"/>
                                            <Label Text="{Binding Cpf}" Style="{StaticResource MutedText}" FontSize="12"/>
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding Email}" Style="{StaticResource MutedText}" FontSize="12"/>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" Spacing="3" VerticalOptions="Center"
                                                         IsVisible="{OnIdiom Phone=False, Default=True}">
                                        <Label Text="{Binding Tipo, Converter={StaticResource EnumDisplay}}"
                                               FontFamily="OpenSansSemibold" FontAttributes="Bold" FontSize="13"/>
                                        <Label Text="{Binding Vinculo, Converter={StaticResource EnumDisplay}}"
                                               Style="{StaticResource MutedText}" FontSize="12"/>
                                    </VerticalStackLayout>

                                    <HorizontalStackLayout Grid.Column="3" Spacing="8" VerticalOptions="Center">
                                        <Button Text="Editar" Style="{StaticResource ButtonSmall}"
                                                Clicked="OnEditButtonClicked"/>
                                        <Button Text="Excluir" Style="{StaticResource ButtonDanger}"
                                                Clicked="OnDeleteButtonClicked"/>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>

        <ActivityIndicator Grid.Row="0" Grid.RowSpan="4"
                           IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}"
                           VerticalOptions="Center" HorizontalOptions="Center"/>
    </Grid>
</ContentPage>
