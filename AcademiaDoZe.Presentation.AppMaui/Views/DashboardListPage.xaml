<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.DashboardListPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             x:DataType="vm:DashboardListViewModel"
             Title="{Binding Title}">
    <ContentPage.Resources>
        <Style TargetType="Border" x:Key="QuickActionRow">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FAF7F2, Dark=#211F1B}" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Line}, Dark=#3D3932}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style TargetType="Border" x:Key="QuickActionBadge">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#24211D, Dark=#3B2C13}" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#3A3530, Dark=#6B4B17}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="HeightRequest" Value="46" />
            <Setter Property="WidthRequest" Value="46" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="Label" x:Key="QuickActionTitle">
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource White}}" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="17" />
        </Style>

        <Style TargetType="Label" x:Key="QuickActionDescription">
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
    </ContentPage.Resources>

    <ContentPage.Padding>
        <OnPlatform x:TypeArguments="Thickness">
            <On Platform="Android" Value="0,8,0,0" />
            <On Platform="iOS" Value="0,12,0,0" />
            <On Platform="MacCatalyst" Value="0" />
            <On Platform="WinUI" Value="0" />
        </OnPlatform>
    </ContentPage.Padding>
    <Grid>
        <ScrollView>
            <VerticalStackLayout x:Name="AnimatedContent"
                                 Padding="{StaticResource PageContentPadding}"
                                 Spacing="24"
                                 MaximumWidthRequest="1040"
                                 HorizontalOptions="Fill">

                <Grid RowDefinitions="Auto,Auto">
                    <Label Text="Início" Style="{StaticResource HeaderTitle}"/>
                    <BoxView Grid.Row="1"
                             Style="{StaticResource SectionRule}"
                             Margin="0,10,0,0"/>
                </Grid>

                <Grid RowDefinitions="Auto,Auto"
                      ColumnSpacing="22"
                      RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{OnIdiom Phone=*, Default=1.15*}" />
                        <ColumnDefinition Width="{OnIdiom Phone=0, Default=0.85*}" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Row="0"
                            Grid.Column="0"
                            BackgroundColor="{StaticResource Tertiary}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 6"
                            Padding="24">
                        <Grid RowDefinitions="Auto,*">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="ACADEMIA DO ZÉ"
                                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gold}}"
                                       FontFamily="OpenSansSemibold"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       CharacterSpacing="0.8"/>
                                <Label Text="Painel administrativo"
                                       TextColor="{StaticResource White}"
                                       FontFamily="OpenSansSemibold"
                                       FontAttributes="Bold"
                                       FontSize="24"/>
                            </VerticalStackLayout>
                            <Image Grid.Row="1"
                                   Source="{Binding LogoImage}"
                                   HeightRequest="220"
                                   Margin="0,18,0,4"
                                   HorizontalOptions="Center"
                                   Aspect="AspectFit"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="{OnIdiom Phone=1, Default=0}"
                            Grid.Column="{OnIdiom Phone=0, Default=1}"
                            Style="{StaticResource FlatSection}">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Resumo" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                            <Grid Padding="0,10" ColumnDefinitions="30,*,Auto" ColumnSpacing="8">
                                <Label Text="&#xe7fd;"
                                       FontFamily="MaterialIcons"
                                       FontSize="20"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                       VerticalTextAlignment="Center"/>
                                <Label Grid.Column="1"
                                       Text="Alunos"
                                       Style="{StaticResource MutedText}"
                                       VerticalTextAlignment="Center"/>
                                <Label Grid.Column="2" Text="{Binding TotalAlunos}" Style="{StaticResource MetricValue}" FontSize="20"/>
                            </Grid>
                            <BoxView Style="{StaticResource SectionRule}"/>
                            <Grid Padding="0,10" ColumnDefinitions="30,*,Auto" ColumnSpacing="8">
                                <Label Text="&#xe0c8;"
                                       FontFamily="MaterialIcons"
                                       FontSize="20"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                       VerticalTextAlignment="Center"/>
                                <Label Grid.Column="1"
                                       Text="Logradouros"
                                       Style="{StaticResource MutedText}"
                                       VerticalTextAlignment="Center"/>
                                <Label Grid.Column="2" Text="{Binding TotalLogradouros}" Style="{StaticResource MetricValue}" FontSize="20"/>
                            </Grid>
                            <BoxView Style="{StaticResource SectionRule}"/>
                            <Grid Padding="0,10" ColumnDefinitions="30,*,Auto" ColumnSpacing="8">
                                <Label Text="&#xea67;"
                                       FontFamily="MaterialIcons"
                                       FontSize="20"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                       VerticalTextAlignment="Center"/>
                                <Label Grid.Column="1"
                                       Text="Colaboradores"
                                       Style="{StaticResource MutedText}"
                                       VerticalTextAlignment="Center"/>
                                <Label Grid.Column="2" Text="{Binding TotalColaboradores}" Style="{StaticResource MetricValue}" FontSize="20"/>
                            </Grid>
                            <BoxView Style="{StaticResource SectionRule}"/>
                            <Grid Padding="0,10" ColumnDefinitions="30,*,Auto" ColumnSpacing="8">
                                <Label Text="&#xe85d;"
                                       FontFamily="MaterialIcons"
                                       FontSize="20"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                       VerticalTextAlignment="Center"/>
                                <Label Grid.Column="1"
                                       Text="Matrículas"
                                       Style="{StaticResource MutedText}"
                                       VerticalTextAlignment="Center"/>
                                <Label Grid.Column="2" Text="{Binding TotalMatriculas}" Style="{StaticResource MetricValue}" FontSize="20"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Style="{StaticResource FlatSection}" Padding="22">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    HeightRequest="52"
                                    WidthRequest="52"
                                    Padding="0">
                                <Label Text="&#xe1b7;"
                                       FontFamily="MaterialIcons"
                                       FontSize="25"
                                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                <Label Text="Área de gestão" Style="{StaticResource CardTitle}" />
                                <Label Text="Acesse as tarefas do dia a dia sem precisar abrir o menu."
                                       Style="{StaticResource MutedText}"
                                       FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView Style="{StaticResource SectionRule}" Margin="0,2,0,4" />

                        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                              RowDefinitions="Auto,12,Auto,12,Auto,12,Auto"
                              ColumnSpacing="14">
                            <Border Grid.Row="0"
                                    Grid.ColumnSpan="4"
                                    Style="{StaticResource QuickActionRow}"
                                    Padding="0" />
                            <Border Grid.Row="0"
                                    Grid.Column="0"
                                    Style="{StaticResource QuickActionBadge}"
                                    Margin="16,12,0,12">
                                <Label Text="&#xe7fd;"
                                       FontFamily="MaterialIcons"
                                       FontSize="23"
                                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gold}}"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Row="0"
                                                 Grid.Column="1"
                                                 Margin="0,12"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                <Label Text="Alunos" Style="{StaticResource QuickActionTitle}" />
                                <Label Text="Dados pessoais, contato e endereço"
                                       Style="{StaticResource QuickActionDescription}" />
                            </VerticalStackLayout>
                            <Button Grid.Row="0"
                                    Grid.Column="2"
                                    Margin="0,12"
                                    Text="Novo aluno"
                                    Command="{Binding NavigateToNovoAlunoCommand}"
                                    Style="{StaticResource ButtonPrimary}"
                                    MinimumWidthRequest="175"
                                    HorizontalOptions="Fill">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="MaterialIcons"
                                                     Glyph="&#xe145;"
                                                     Size="18"
                                                     Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                </Button.ImageSource>
                            </Button>
                            <Button Grid.Row="0"
                                    Grid.Column="3"
                                    Margin="0,12,16,12"
                                    Text="Consultar alunos"
                                    Command="{Binding NavigateToAlunosCommand}"
                                    Style="{StaticResource ButtonSecondary}"
                                    MinimumWidthRequest="175"
                                    HorizontalOptions="Fill">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="MaterialIcons"
                                                     Glyph="&#xe8b6;"
                                                     Size="18"
                                                     Color="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource White}}" />
                                </Button.ImageSource>
                            </Button>

                            <Border Grid.Row="2"
                                    Grid.ColumnSpan="4"
                                    Style="{StaticResource QuickActionRow}"
                                    Padding="0" />
                            <Border Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource QuickActionBadge}"
                                    Margin="16,12,0,12">
                                <Label Text="&#xe85d;"
                                       FontFamily="MaterialIcons"
                                       FontSize="23"
                                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gold}}"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Row="2"
                                                 Grid.Column="1"
                                                 Margin="0,12"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                <Label Text="Matrículas" Style="{StaticResource QuickActionTitle}" />
                                <Label Text="Planos, vigências e condições de saúde"
                                       Style="{StaticResource QuickActionDescription}" />
                            </VerticalStackLayout>
                            <Button Grid.Row="2"
                                    Grid.Column="2"
                                    Margin="0,12"
                                    Text="Nova matrícula"
                                    Command="{Binding NavigateToNovaMatriculaCommand}"
                                    Style="{StaticResource ButtonPrimary}"
                                    MinimumWidthRequest="175"
                                    HorizontalOptions="Fill">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="MaterialIcons"
                                                     Glyph="&#xe145;"
                                                     Size="18"
                                                     Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                </Button.ImageSource>
                            </Button>
                            <Button Grid.Row="2"
                                    Grid.Column="3"
                                    Margin="0,12,16,12"
                                    Text="Consultar matrículas"
                                    Command="{Binding NavigateToMatriculasCommand}"
                                    Style="{StaticResource ButtonSecondary}"
                                    MinimumWidthRequest="175"
                                    HorizontalOptions="Fill">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="MaterialIcons"
                                                     Glyph="&#xe8b6;"
                                                     Size="18"
                                                     Color="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource White}}" />
                                </Button.ImageSource>
                            </Button>

                            <Border Grid.Row="4"
                                    Grid.ColumnSpan="4"
                                    Style="{StaticResource QuickActionRow}"
                                    Padding="0" />
                            <Border Grid.Row="4"
                                    Grid.Column="0"
                                    Style="{StaticResource QuickActionBadge}"
                                    Margin="16,12,0,12">
                                <Label Text="&#xea67;"
                                       FontFamily="MaterialIcons"
                                       FontSize="23"
                                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gold}}"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Row="4"
                                                 Grid.Column="1"
                                                 Margin="0,12"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                <Label Text="Colaboradores" Style="{StaticResource QuickActionTitle}" />
                                <Label Text="Equipe, função e vínculo de trabalho"
                                       Style="{StaticResource QuickActionDescription}" />
                            </VerticalStackLayout>
                            <Button Grid.Row="4"
                                    Grid.Column="2"
                                    Margin="0,12"
                                    Text="Novo colaborador"
                                    Command="{Binding NavigateToNovoColaboradorCommand}"
                                    Style="{StaticResource ButtonPrimary}"
                                    MinimumWidthRequest="175"
                                    HorizontalOptions="Fill">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="MaterialIcons"
                                                     Glyph="&#xe145;"
                                                     Size="18"
                                                     Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                </Button.ImageSource>
                            </Button>
                            <Button Grid.Row="4"
                                    Grid.Column="3"
                                    Margin="0,12,16,12"
                                    Text="Consultar colaboradores"
                                    Command="{Binding NavigateToColaboradoresCommand}"
                                    Style="{StaticResource ButtonSecondary}"
                                    MinimumWidthRequest="175"
                                    HorizontalOptions="Fill">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="MaterialIcons"
                                                     Glyph="&#xe8b6;"
                                                     Size="18"
                                                     Color="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource White}}" />
                                </Button.ImageSource>
                            </Button>

                            <Border Grid.Row="6"
                                    Grid.ColumnSpan="4"
                                    Style="{StaticResource QuickActionRow}"
                                    Padding="0" />
                            <Border Grid.Row="6"
                                    Grid.Column="0"
                                    Style="{StaticResource QuickActionBadge}"
                                    Margin="16,12,0,12">
                                <Label Text="&#xe0c8;"
                                       FontFamily="MaterialIcons"
                                       FontSize="23"
                                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gold}}"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Row="6"
                                                 Grid.Column="1"
                                                 Margin="0,12"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                <Label Text="Logradouros" Style="{StaticResource QuickActionTitle}" />
                                <Label Text="Endereços e CEPs disponíveis"
                                       Style="{StaticResource QuickActionDescription}" />
                            </VerticalStackLayout>
                            <Button Grid.Row="6"
                                    Grid.Column="2"
                                    Margin="0,12"
                                    Text="Novo logradouro"
                                    Command="{Binding NavigateToNovoLogradouroCommand}"
                                    Style="{StaticResource ButtonPrimary}"
                                    MinimumWidthRequest="175"
                                    HorizontalOptions="Fill">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="MaterialIcons"
                                                     Glyph="&#xe145;"
                                                     Size="18"
                                                     Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                </Button.ImageSource>
                            </Button>
                            <Button Grid.Row="6"
                                    Grid.Column="3"
                                    Margin="0,12,16,12"
                                    Text="Consultar logradouros"
                                    Command="{Binding NavigateToLogradourosCommand}"
                                    Style="{StaticResource ButtonSecondary}"
                                    MinimumWidthRequest="175"
                                    HorizontalOptions="Fill">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="MaterialIcons"
                                                     Glyph="&#xe8b6;"
                                                     Size="18"
                                                     Color="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource White}}" />
                                </Button.ImageSource>
                            </Button>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="14"
                              Padding="16,12,16,0">
                            <Label Text="&#xe8b8;"
                                   FontFamily="MaterialIcons"
                                   FontSize="23"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gold}}"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   WidthRequest="46" />
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="1">
                                <Label Text="Configurações"
                                       Style="{StaticResource QuickActionTitle}"
                                       FontSize="15" />
                                <Label Text="Tema e conexão com o banco de dados"
                                       Style="{StaticResource QuickActionDescription}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2"
                                    Text="Abrir configurações"
                                    Command="{Binding NavigateToConfiguracoesCommand}"
                                    Style="{StaticResource ButtonSecondary}"
                                    MinimumWidthRequest="175"
                                    HorizontalOptions="Fill">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="MaterialIcons"
                                                     Glyph="&#xe8b8;"
                                                     Size="18"
                                                     Color="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource White}}" />
                                </Button.ImageSource>
                            </Button>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,Auto,*" Margin="0,2,0,0">
                    <BoxView VerticalOptions="Center"
                             HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"/>
                    <Label Grid.Column="1"
                           Text="Academia do Zé  ·  Sistema administrativo  ·  Vitor Hugo Ribeiro Sá"
                           Style="{StaticResource MutedText}"
                           FontSize="11"
                           Margin="14,0"/>
                    <BoxView Grid.Column="2"
                             VerticalOptions="Center"
                             HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"/>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsVisible="{Binding IsBusy}"
                           IsRunning="{Binding IsBusy}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>
    </Grid>
</ContentPage>
