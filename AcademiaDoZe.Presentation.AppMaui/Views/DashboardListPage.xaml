<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.DashboardListPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             x:DataType="vm:DashboardListViewModel"
             Title="{Binding Title}">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="32,24,32,36"
                                 Spacing="20"
                                 MaximumWidthRequest="1000"
                                 HorizontalOptions="Fill">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Visão geral" Style="{StaticResource SectionTitle}"/>
                        <Label Text="Resumo dos cadastros da academia."
                               Style="{StaticResource MutedText}"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="1"
                           Text="Dashboard"
                           Style="{StaticResource MutedText}"
                           VerticalOptions="Center"/>
                </Grid>

                <Border Style="{StaticResource HeroBorder}">
                    <Image Source="academiadoze.png"
                           HeightRequest="190"
                           MaximumWidthRequest="620"
                           HorizontalOptions="Center"
                           Aspect="AspectFit"/>
                </Border>

                <Label Text="Indicadores" Style="{StaticResource SectionTitle}" FontSize="20"/>

                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="*,*"
                      RowSpacing="12"
                      ColumnSpacing="12">
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToLogradourosCommand}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Logradouros" Style="{StaticResource MutedText}"/>
                            <Label Text="{Binding TotalLogradouros}" Style="{StaticResource MetricValue}"/>
                            <Label Text="Abrir cadastro" TextColor="{StaticResource Primary}" FontFamily="OpenSansSemibold" FontSize="12"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToAlunosCommand}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Alunos" Style="{StaticResource MutedText}"/>
                            <Label Text="{Binding TotalAlunos}" Style="{StaticResource MetricValue}"/>
                            <Label Text="Cadastros registrados" Style="{StaticResource MutedText}" FontSize="12"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MetricCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToColaboradoresCommand}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Colaboradores" Style="{StaticResource MutedText}"/>
                            <Label Text="{Binding TotalColaboradores}" Style="{StaticResource MetricValue}"/>
                            <Label Text="Equipe cadastrada" Style="{StaticResource MutedText}" FontSize="12"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToMatriculasCommand}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Matrículas" Style="{StaticResource MutedText}"/>
                            <Label Text="{Binding TotalMatriculas}" Style="{StaticResource MetricValue}"/>
                            <Label Text="Planos registrados" Style="{StaticResource MutedText}" FontSize="12"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsVisible="{Binding IsBusy}"
                           IsRunning="{Binding IsBusy}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>
    </Grid>
</ContentPage>
